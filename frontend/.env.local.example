# ========================================
# FRONTEND ENVIRONMENT VARIABLES
# ========================================
# Copy this file to .env.local and fill in your values
# DO NOT COMMIT .env.local to Git (already in .gitignore)
# ========================================

# ========================================
# FIREBASE CONFIGURATION (Web App - Public)
# ========================================
# Get these values from Firebase Console → Project Settings → Web App
# These are PUBLIC configuration (safe in browser)
# Do NOT put the Firebase Admin private key here

VITE_FIREBASE_API_KEY=AIzaSyBfaN5KTUXNGfZL2qzzi8nv1qEGAdkZLU
# Firebase Web API key

VITE_FIREBASE_AUTH_DOMAIN=genesis-ec0bd.firebaseapp.com
# Firebase auth domain

VITE_FIREBASE_PROJECT_ID=genesis-ec0bd
# Firebase project ID

VITE_FIREBASE_STORAGE_BUCKET=genesis-ec0bd.firebasestorage.app
# Firebase storage bucket

VITE_FIREBASE_MESSAGING_SENDER_ID=197595305755
# Firebase messaging sender ID

VITE_FIREBASE_APP_ID=1:197595305755:web:72998a2f5781e2330ca3a
# Firebase app ID

VITE_FIREBASE_MEASUREMENT_ID=G-X8QH3J342Z
# Firebase Google Analytics ID (optional)

# ========================================
# API CONFIGURATION
# ========================================

VITE_API_URL=http://localhost:5000/api
# Backend API URL
# For production: VITE_API_URL=https://api.yourdomain.com/api

# ========================================
# DEPLOYMENT CHECKLIST
# ========================================
# Before deploying, ensure:
# ✓ VITE_FIREBASE_* variables are set (from Firebase Console)
# ✓ VITE_API_URL points to your backend domain
# ✓ .env.local file is NOT committed to Git
# ✓ No secrets (API keys) are hardcoded in components

# ========================================
# DEPLOYMENT PLATFORMS
# ========================================

# VERCEL (Frontend)
# Set these env vars in Vercel Dashboard:
# - All VITE_FIREBASE_* variables
# - VITE_API_URL=https://your-backend-domain.com/api

# RENDER (Frontend alternative)
# Set these env vars in Render Dashboard:
# - All VITE_FIREBASE_* variables
# - VITE_API_URL=https://your-backend-domain.com/api
