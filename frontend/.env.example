################################################################################
# FRONTEND ENVIRONMENT CONFIGURATION - EXAMPLE
# Copy this file to .env.local and fill in your actual values
# These are PUBLIC values (Firebase Web API key is public by design)
# Secrets are handled in backend .env only
################################################################################

# ============================================================================
# BACKEND API CONFIGURATION
# ============================================================================
# Development: http://localhost:5000/api
# Production: https://your-backend-url.onrender.com/api
VITE_API_URL=http://localhost:5000/api

# ============================================================================
# FIREBASE WEB APP CONFIGURATION
# These are PUBLIC (Firebase API key is public by design)
# Get these from Firebase Console > Project Settings > Web App
# ============================================================================
VITE_FIREBASE_API_KEY=your-firebase-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
VITE_FIREBASE_APP_ID=your-app-id
