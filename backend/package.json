{
  "name": "invoice-expense-backend",
  "version": "1.0.0",
  "description": "Phase 1 backend foundation for the AI-Powered Invoice & Expense Management System.",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "test": "tsx src/modules/anomaly/__tests__/anomaly.test.ts && tsx src/modules/invoices/__tests__/invoice.test.ts && tsx src/modules/invoices/__tests__/invoice.routes.test.ts",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "invoice",
    "expense",
    "firebase",
    "express",
    "typescript"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "firebase-admin": "^12.4.0",
    "helmet": "^7.1.0",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "uuid": "^9.0.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/morgan": "^1.9.9",
    "@types/multer": "^1.4.11",
    "@types/node": "^22.5.4",
    "@types/uuid": "^9.0.7",
    "tsx": "^4.19.1",
    "typescript": "^5.5.4"
  }
}
