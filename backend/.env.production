# Production Environment Configuration
# Used when deployed to Render.com

NODE_ENV=production
PORT=5000

# Gemini API Configuration
# Set GEMINI_API_KEY in Render Dashboard environment variables
# GEMINI_API_KEY=[Set in Render Dashboard]
GEMINI_EXTRACTION_MODEL=gemini-pro-vision
GEMINI_CATEGORIZATION_MODEL=gemini-pro

# CORS Configuration - Allow frontend domain
CORS_ORIGIN=https://invoice-flow-frontend.onrender.com

# Firebase Admin SDK Configuration
# Set FIREBASE_CLIENT_EMAIL and FIREBASE_PRIVATE_KEY in Render Dashboard
FIREBASE_PROJECT_ID=genesis-ec0bd
# FIREBASE_CLIENT_EMAIL=[Set in Render Dashboard]
# FIREBASE_PRIVATE_KEY=[Set in Render Dashboard]
FIREBASE_STORAGE_BUCKET=genesis-ec0bd.firebasestorage.app
