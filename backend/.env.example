# ========================================
# BACKEND ENVIRONMENT VARIABLES
# ========================================
# Copy this file to .env and fill in your values
# DO NOT COMMIT .env file to Git (already in .gitignore)
# ========================================

# ========================================
# NODE ENVIRONMENT
# ========================================
NODE_ENV=development
# Options: development, test, production

# ========================================
# SERVER CONFIGURATION
# ========================================
PORT=5000
CORS_ORIGIN=http://localhost:5173
# For production: CORS_ORIGIN=https://yourdomain.com

# ========================================
# FIREBASE ADMIN SDK (Backend Only)
# ========================================
# Get these from Firebase Console → Project Settings → Service Accounts
# Generate a new private key to get these values

FIREBASE_PROJECT_ID=genesis-ec0bd
# Your Firebase project ID

FIREBASE_CLIENT_EMAIL=firebase-adminsdk-fbsvc@genesis-ec0bd.iam.gserviceaccount.com
# Service account email (format: firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com)

FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# Private key from service account JSON
# IMPORTANT: Keep newlines as \n in the string
# Copy the entire private_key value including BEGIN/END markers

FIREBASE_STORAGE_BUCKET=genesis-ec0bd.firebasestorage.app
# Your Firebase storage bucket

# ========================================
# GEMINI API CONFIGURATION
# ========================================
# Get from https://aistudio.google.com/app/apikey
# Format: AIzaSy_... (NOT AQ....)

GEMINI_API_KEY=AIzaSy_YOUR_GEMINI_API_KEY_HERE
# Google Gemini API key for OCR and extraction
# IMPORTANT: Must start with AIzaSy_

GEMINI_EXTRACTION_MODEL=gemini-pro-vision
# Model for invoice document extraction/OCR
# Options: gemini-pro-vision, gemini-1.5-flash, etc.

GEMINI_CATEGORIZATION_MODEL=gemini-pro
# Model for invoice categorization
# Options: gemini-pro, gemini-1.5-flash, etc.

# ========================================
# OPTIONAL: EMAIL SERVICE (For Production)
# ========================================
# If using real SMTP instead of mock provider

SMTP_HOST=smtp.gmail.com
# Your SMTP server host

SMTP_PORT=587
# SMTP port (typically 587 for TLS, 465 for SSL)

SMTP_USER=your-email@gmail.com
# SMTP username/email

SMTP_PASSWORD=your-app-specific-password
# SMTP password (use app-specific password for Gmail)

SMTP_FROM_EMAIL=noreply@invoice-system.com
# Email address for notifications

# ========================================
# OPTIONAL: ERP INTEGRATION
# ========================================
# For production, replace mock provider with real ERP

NETSUITE_ACCOUNT_ID=your-netsuite-account
# NetSuite account ID

NETSUITE_API_KEY=your-netsuite-api-key
# NetSuite API key

NETSUITE_API_SECRET=your-netsuite-api-secret
# NetSuite API secret

# ========================================
# OPTIONAL: LOGGING & MONITORING
# ========================================

LOG_LEVEL=debug
# Options: debug, info, warn, error
# Use 'info' for production

SENTRY_DSN=
# Sentry DSN for error tracking (optional)

# ========================================
# DATABASE (If switching from Firestore)
# ========================================
# Currently using Firestore, but here's the format if you add a SQL database

DATABASE_URL=
# Example: postgresql://user:password@localhost:5432/invoiceflow

# ========================================
# DEPLOYMENT CHECKLIST
# ========================================
# Before deploying, ensure:
# ✓ NODE_ENV=production
# ✓ CORS_ORIGIN points to your domain
# ✓ FIREBASE_PRIVATE_KEY is properly escaped
# ✓ GEMINI_API_KEY is valid (AIzaSy_ format)
# ✓ All required Firebase variables are set
# ✓ .env file is NOT committed to Git
# ✓ Secrets are stored securely in deployment platform

# ========================================
# DEPLOYMENT PLATFORMS
# ========================================

# RENDER (Backend)
# Set these env vars in Render Dashboard:
# - All FIREBASE_* variables
# - All GEMINI_* variables
# - NODE_ENV=production
# - PORT (auto-set by Render, but can override)
# - CORS_ORIGIN=https://your-frontend-domain.com

# VERCEL (Frontend, if hosting there)
# Frontend uses VITE_* prefixed variables (see frontend/.env.example)
