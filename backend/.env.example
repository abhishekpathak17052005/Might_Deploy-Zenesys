################################################################################
# BACKEND ENVIRONMENT CONFIGURATION - EXAMPLE
# Copy this file to .env and fill in your actual values
# IMPORTANT: .env is in .gitignore and not tracked by Git
################################################################################

# ============================================================================
# NODE ENVIRONMENT
# ============================================================================
NODE_ENV=development
PORT=5000

# ============================================================================
# DATABASE CONFIGURATION (MONGODB)
# ============================================================================
DATABASE_URL=mongodb://localhost:27017/InvoiceFlow

# ============================================================================
# AUTHENTICATION (JWT)
# ============================================================================
# Must be at least 32 characters in production
JWT_SECRET=supersecret-dev-jwt-key-not-for-production-min32chars

# ============================================================================
# CORS CONFIGURATION
# ============================================================================
# Set to your frontend URL
CORS_ORIGIN=http://localhost:5173

# ============================================================================
# FIREBASE ADMIN SDK CONFIGURATION
# Get these from Firebase Console > Project Settings > Service Account
# ============================================================================
FIREBASE_PROJECT_ID=genesis-ec0bd
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-fbsvc@genesis-ec0bd.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
FIREBASE_STORAGE_BUCKET=genesis-ec0bd.firebasestorage.app

# ============================================================================
# OPTIONAL GEMINI STRUCTURING CONFIGURATION
# OCR.space reads text from the uploaded document. Gemini can structure that OCR text into fields.
# If no Gemini key is configured, the backend uses its conservative text parser and marks missing values for review.
# ============================================================================
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_EXTRACTION_MODEL=gemini-3.6-flash
GEMINI_CATEGORIZATION_MODEL=gemini-pro

# ============================================================================
# OCR SERVICE CONFIGURATION
# OCR.space performs OCR. Gemini is optional and receives OCR text for structured extraction.
# ============================================================================

EXTRACTION_PROVIDER=ocr_space
OCR_SPACE_API_KEY=replace-with-server-side-key
OCR_SPACE_ENDPOINT=https://api.ocr.space/parse/image

# Ollama Configuration (ALTERNATIVE - LOCAL OCR - COMPLETELY FREE)
# Requirements: Install Ollama from https://ollama.ai and run: ollama serve
# EXTRACTION_PROVIDER=ollama
# OLLAMA_URL=http://localhost:11434
# OLLAMA_MODEL=glm
# OLLAMA_TIMEOUT=60000

# Groq API Configuration (primary or fallback for OCR-text structuring)
PRIMARY_STRUCTURER=groq
GROQ_API_KEY=[Your Groq API key]
GROQ_EXTRACTION_MODEL=qwen/qwen3.8-27b
