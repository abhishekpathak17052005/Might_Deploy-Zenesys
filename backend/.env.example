################################################################################
# BACKEND ENVIRONMENT CONFIGURATION - EXAMPLE
# Copy this file to .env and fill in your actual values
# IMPORTANT: .env is in .gitignore and not tracked by Git
################################################################################

# ============================================================================
# NODE ENVIRONMENT
# ============================================================================
NODE_ENV=development
PORT=5000

# ============================================================================
# CORS CONFIGURATION
# ============================================================================
# Set to your frontend URL
CORS_ORIGIN=http://localhost:5173

# ============================================================================
# FIREBASE ADMIN SDK CONFIGURATION
# Get these from Firebase Console > Project Settings > Service Account
# ============================================================================
FIREBASE_PROJECT_ID=genesis-ec0bd
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-fbsvc@genesis-ec0bd.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
FIREBASE_STORAGE_BUCKET=genesis-ec0bd.firebasestorage.app

# ============================================================================
# GEMINI AI CONFIGURATION
# Get API key from Google AI Studio or Google Cloud Console
# ============================================================================
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_EXTRACTION_MODEL=gemini-pro-vision
GEMINI_CATEGORIZATION_MODEL=gemini-pro

# ============================================================================
# OCR SERVICE CONFIGURATION
# CHOICE 1: Ollama (FREE, LOCAL) - Recommended for development/self-hosted
# CHOICE 2: Gemini API (CLOUD, COSTS MONEY) - For cloud deployments
# ============================================================================

# Ollama Configuration (LOCAL OCR - COMPLETELY FREE)
# Requirements: Install Ollama from https://ollama.ai and run: ollama serve
EXTRACTION_PROVIDER=ollama
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=glm
OLLAMA_TIMEOUT=60000

# Gemini API (Alternative - CLOUD, COSTS ~$0.05-0.10 per image)
# Only needed if using "gemini" as EXTRACTION_PROVIDER
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_EXTRACTION_MODEL=gemini-pro-vision
GEMINI_CATEGORIZATION_MODEL=gemini-pro
